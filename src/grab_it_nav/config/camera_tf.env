# Shared base_link -> camera_link extrinsic for mapping AND localization.
# MUST be identical for map build and nav — mismatch = persistent pose offset.
#
# For NAV/mapping only: assumes pan/tilt ≈ 0 (calibration pose).
# Click-to-grasp uses URDF d435i_* frames that follow the pan joint, so you
# can tilt the camera down and still grab. Remap if you change these values.
#
# Measure on the robot:
#   x = forward from base center to camera_link (m)
#   y = left (m)
#   z = up (m)
#   pitch = camera tilt down (rad); 0.35 ≈ 20°
#
# After changing these values you MUST remap (bash remap_map.sh).
CAM_TF_X=0.15
CAM_TF_Y=0.0
CAM_TF_Z=0.30
CAM_TF_ROLL=0.0
CAM_TF_PITCH=0.35
CAM_TF_YAW=0.0

CAM_FRAME=camera_link
CAM_OPTICAL=camera_color_optical_frame
